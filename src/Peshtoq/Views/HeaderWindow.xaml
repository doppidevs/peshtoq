<Window x:Class="Peshtoq.Views.HeaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Peshtoq"
        Left="0" Top="0" Width="1280" Height="34"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource UiFont}" FontSize="12.5"
        Foreground="{StaticResource FgBrush}"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- left: launcher + active window -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource HeaderButton}" ToolTip="Start menyusi" Click="Launcher_Click">
                    <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                </Button>
                <Button Style="{StaticResource HeaderButton}" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="AppName" FontWeight="SemiBold" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="WindowTitle" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0"
                                   MaxWidth="320" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- right: status -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource HeaderButton}" ToolTip="Bildirishnomalar markazi" Click="ActionCenter_Click">
                    <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                </Button>
                <Button x:Name="NetworkButton" Style="{StaticResource HeaderButton}" Click="Network_Click">
                    <TextBlock x:Name="NetworkIcon" Text="&#xE701;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                </Button>
                <Button x:Name="VolumeButton" Style="{StaticResource HeaderButton}" Click="Volume_Click"
                        MouseWheel="Volume_Wheel">
                    <TextBlock x:Name="VolumeIcon" Text="&#xE995;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                </Button>
                <Button x:Name="BatteryButton" Style="{StaticResource HeaderButton}" Click="Battery_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="BatteryIcon" Text="&#xEBA8;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="BatteryText" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource HeaderButton}" ToolTip="Kalendar va bildirishnomalar" Click="ActionCenter_Click">
                    <TextBlock x:Name="ClockText" FontWeight="Medium" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
