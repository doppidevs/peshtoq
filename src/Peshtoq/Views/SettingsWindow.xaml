<Window x:Class="Peshtoq.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Peshtoq — Sozlamalar"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="#15181F" Foreground="{StaticResource FgBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- accent colour swatch -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Ellipse x:Name="Ring" Stroke="{StaticResource FgBrush}" StrokeThickness="0" />
                            <Ellipse Margin="4" Fill="{TemplateBinding Background}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="StrokeThickness" Value="2.5" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="StrokeThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20">

        <TextBlock Text="Tablar joylashuvi" Style="{StaticResource SectionLabel}" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <RadioButton x:Name="SideLeft" GroupName="layout" Content="Chapda" Margin="0,0,20,0" />
            <RadioButton x:Name="SideTop" GroupName="layout" Content="Tepada" />
        </StackPanel>

        <Grid Margin="0,0,0,18">
            <TextBlock Text="Trigger zonasi kengligi" Style="{StaticResource SectionLabel}" />
            <TextBlock x:Name="TriggerValue" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" />
            <Slider x:Name="TriggerSlider" Minimum="80" Maximum="320" TickFrequency="10" IsSnapToTickEnabled="True"
                    Margin="0,26,0,0" VerticalAlignment="Bottom" />
        </Grid>

        <Grid Margin="0,0,0,18">
            <TextBlock Text="Ochilish kechikishi" Style="{StaticResource SectionLabel}" />
            <TextBlock x:Name="DwellValue" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" />
            <Slider x:Name="DwellSlider" Minimum="40" Maximum="250" TickFrequency="10" IsSnapToTickEnabled="True"
                    Margin="0,26,0,0" VerticalAlignment="Bottom" />
        </Grid>

        <TextBlock Text="Accent rang" Style="{StaticResource SectionLabel}" />
        <StackPanel x:Name="Swatches" Orientation="Horizontal" Margin="0,0,0,18">
            <RadioButton Style="{StaticResource Swatch}" GroupName="accent" Tag="#5AA2FF" Background="#5AA2FF" />
            <RadioButton Style="{StaticResource Swatch}" GroupName="accent" Tag="#3DDC97" Background="#3DDC97" />
            <RadioButton Style="{StaticResource Swatch}" GroupName="accent" Tag="#B98AFF" Background="#B98AFF" />
            <RadioButton Style="{StaticResource Swatch}" GroupName="accent" Tag="#FFB648" Background="#FFB648" />
            <RadioButton Style="{StaticResource Swatch}" GroupName="accent" Tag="#FF6FB5" Background="#FF6FB5" />
        </StackPanel>

        <TextBlock Text="Ko'rinadigan tablar" Style="{StaticResource SectionLabel}" />
        <StackPanel Margin="0,0,0,18">
            <CheckBox x:Name="TabMedia" Content="Media" />
            <CheckBox x:Name="TabNotes" Content="Eslatmalar" />
            <CheckBox x:Name="TabClip" Content="Clipboard" />
            <CheckBox x:Name="TabSys" Content="Tizim" />
        </StackPanel>

        <CheckBox x:Name="StartupCheck" Content="Windows bilan ishga tushirish" Margin="0,0,0,20" />

        <Border Height="1" Background="#262B36" Margin="0,0,0,18" />
        <TextBlock Text="Link — qurilmalararo (bir LAN)" Style="{StaticResource SectionLabel}" />
        <CheckBox x:Name="LinkCheck" Content="Yoqish" Margin="0,0,0,8" />
        <TextBlock x:Name="LinkStatus" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

        <TextBlock x:Name="PeersHeader" Text="Topilgan qurilmalar" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
        <ItemsControl x:Name="PeerList" Margin="0,0,0,12" />

        <TextBlock x:Name="PairedHeader" Text="Juftlangan qurilmalar" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
        <ItemsControl x:Name="PairedList" Margin="0,0,0,20" />

        <Border Height="1" Background="#262B36" Margin="0,0,0,18" />
        <TextBlock Text="Yangilanish" Style="{StaticResource SectionLabel}" />
        <TextBlock x:Name="UpdateStatus" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Button x:Name="CheckUpdateButton" Content="Yangilanishni tekshirish" Padding="14,7"
                    Background="#2A2F3A" Foreground="{StaticResource FgBrush}" BorderThickness="0" Cursor="Hand"
                    Click="CheckUpdate_Click">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style></Button.Resources>
            </Button>
            <Button x:Name="RestartUpdateButton" Content="Qayta ishga tushirish va yangilash" Padding="14,7" Margin="10,0,0,0"
                    Visibility="Collapsed" Background="{StaticResource AccentBrush}" Foreground="White"
                    BorderThickness="0" Cursor="Hand" Click="RestartUpdate_Click">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style></Button.Resources>
            </Button>
        </StackPanel>

        <Button x:Name="CloseButton" Content="Yopish" HorizontalAlignment="Right"
                Padding="18,8" Background="{StaticResource AccentBrush}" Foreground="White"
                BorderThickness="0" Cursor="Hand" Click="Close_Click">
            <Button.Resources>
                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
            </Button.Resources>
        </Button>
    </StackPanel>
</Window>
