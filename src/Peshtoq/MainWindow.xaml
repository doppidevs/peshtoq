<Window x:Class="Peshtoq.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Peshtoq"
        Height="34"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#C7101218"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid Margin="10,0">
        <TextBlock Text="Peshtoq" Foreground="#F2F4F8" VerticalAlignment="Center" FontWeight="SemiBold" />
        <TextBlock x:Name="Clock" Foreground="#F2F4F8" VerticalAlignment="Center" HorizontalAlignment="Right" />
    </Grid>
</Window>
